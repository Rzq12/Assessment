# Evaluator LLM. Kosongkan LLM_PROVIDER atau LLM_API_KEY agar mesin penilaian dianggap belum tersedia.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.riezqidr.my.id/v1
LLM_MODEL=cx/gpt-6-luna
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Suhu rendah menjaga skor tetap konsisten antar penilaian (0 sampai 2).
LLM_TEMPERATURE=0
# Model untuk vision; kosong berarti memakai LLM_MODEL.
LLM_VISION_MODEL=

# Penilaian
PASSING_SCORE=75
MAX_JOURNAL_CHARACTERS=20000
# Kosong berarti memakai app/core/criteria.json.
CRITERIA_FILE=

# Pemrosesan materi (python -m app.ingest)
MATERIALS_DIR=Docs Materi
PROCESSED_DIR=material_cache
# auto, easyocr, tesseract, rapidocr, atau none
OCR_ENGINE=auto
# Kode bahasa OCR dipisah koma; kosong berarti id,en (ind,eng untuk tesseract).
OCR_LANG=
# true mengirim gambar materi yang tidak terbaca ke provider LLM di atas.
VISION_ENABLED=false
